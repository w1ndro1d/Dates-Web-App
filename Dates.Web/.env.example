# Backend only. Never prefix secrets with VITE_. Copy to ignored .env.local for local development.
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
APP_ORIGIN=http://localhost:5173
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-sender@gmail.com
SMTP_NAME=Dates Reminders
# Enable only on the production deployment after testing with a staging database.
REMINDERS_ENABLED=false
